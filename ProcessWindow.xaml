<Window x:Class="SysPulse.ProcessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SysPulse"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SysPulse 进程明细" Icon="Assets/SysPulse.ico" Width="540" Height="470" ResizeMode="NoResize"
        WindowStyle="None" ShowInTaskbar="False" FontSize="12" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="ProcessAction" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="{DynamicResource ProcessText}"/>
            <Setter Property="Background" Value="{DynamicResource ProcessSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ProcessHeaderLine}"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="ButtonFace" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonFace" Property="Background" Value="{DynamicResource ProcessHeaderHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonFace" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ProcessAction}"/>
        <Style TargetType="ToggleButton" BasedOn="{StaticResource ProcessAction}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ProcessSelected}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource ProcessText}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ProcessText}"/>
            <Setter Property="Background" Value="{DynamicResource ProcessSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ProcessHeaderLine}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputFace" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <!-- TextBox 自己把 Padding 传给内容宿主，模板无需再加一遍。 -->
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputFace" Property="BorderBrush" Value="{DynamicResource ProcessHeaderText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NumericCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
        <Style x:Key="ColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource ProcessHeaderText}"/>
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border x:Name="HeaderSurface" Background="{DynamicResource ProcessHeader}"
                                BorderBrush="{DynamicResource ProcessHeaderLine}" BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Path x:Name="SortMark" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Fill="{TemplateBinding Foreground}" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource ProcessHeaderHover}"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortMark" Property="Data" Value="M 0,4 L 3,0 L 6,4 Z"/>
                                <Setter TargetName="SortMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortMark" Property="Data" Value="M 0,0 L 3,4 L 6,0 Z"/>
                                <Setter TargetName="SortMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="12,0,12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <ToggleButton x:Name="CompactButton" Width="32" Margin="0,0,5,0"
                              ToolTip="切换简化模式" AutomationProperties.Name="切换简化模式" Checked="ToggleCompact" Unchecked="ToggleCompact">
                    <local:PanelIcon x:Name="CompactIcon" Data="{StaticResource IconMinimize}"/>
                </ToggleButton>
                <ToggleButton x:Name="PinButton" Width="32" Margin="0,0,5,0" Checked="TogglePin" Unchecked="TogglePin"
                              ToolTip="固定窗口，点击外部时保留" AutomationProperties.Name="固定窗口">
                    <local:PanelIcon Data="{StaticResource IconPin}"/>
                </ToggleButton>
                <Button Width="32" ToolTip="关闭" AutomationProperties.Name="关闭" Click="Dismiss">
                    <local:PanelIcon Data="{StaticResource IconClose}"/>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <local:PanelIcon Data="{StaticResource IconList}" Foreground="{DynamicResource ProcessHeaderText}"
                                 Margin="0,0,7,0"/>
                <TextBlock Text="进程明细" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <TextBox x:Name="Search" AutomationProperties.Name="搜索应用" Padding="27,5,8,5"
                     TextChanged="SearchChanged" GotKeyboardFocus="SearchFocusChanged"
                     LostKeyboardFocus="SearchFocusChanged"/>
            <TextBlock x:Name="SearchHint" Text="搜索应用" Opacity="0.65" IsHitTestVisible="False"
                       Margin="29,0,0,0" VerticalAlignment="Center"/>
            <local:PanelIcon Data="{StaticResource IconSearch}" Width="14" Height="14" Margin="8,0,0,0"
                             HorizontalAlignment="Left" Foreground="{DynamicResource ProcessHeaderText}"
                             IsHitTestVisible="False"/>
        </Grid>
        <DataGrid x:Name="Table" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                  CanUserResizeRows="False" CanUserResizeColumns="False" SelectionMode="Single"
                  RowHeight="28" HeadersVisibility="Column" GridLinesVisibility="None"
                  Background="{DynamicResource ProcessSurface}" Foreground="{DynamicResource ProcessText}"
                  RowBackground="{DynamicResource ProcessSurface}" AlternatingRowBackground="{DynamicResource ProcessAlternate}"
                  BorderBrush="{DynamicResource ProcessHeaderLine}" BorderThickness="1"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ColumnHeaderStyle="{StaticResource ColumnHeader}" Sorting="SortColumn"
                  EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Resources>
                <!-- WPF Track 以此资源的一半作为滑块最小高度，此处为 32 DIP。 -->
                <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">64</sys:Double>
                <Style TargetType="ScrollBar">
                    <Setter Property="Width" Value="16"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Grid Background="Transparent">
                                                        <Border x:Name="Grip" Width="8" CornerRadius="4" Opacity="0.65"
                                                                Background="{DynamicResource ProcessHeaderText}"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Grip" Property="Opacity" Value="0.9"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="Grip" Property="Opacity" Value="1"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.Resources>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Foreground" Value="{DynamicResource ProcessText}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ProcessSelected}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn x:Name="NameColumn" Header="应用" SortMemberPath="name" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="5,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="21"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                                <local:PanelIcon Data="{StaticResource IconMonitor}" Width="14" Height="14"
                                                 Foreground="{DynamicResource ProcessHeaderText}" HorizontalAlignment="Left">
                                    <local:PanelIcon.Style>
                                        <Style TargetType="local:PanelIcon" BasedOn="{StaticResource {x:Type local:PanelIcon}}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </local:PanelIcon.Style>
                                </local:PanelIcon>
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding DisplayName}" ToolTipService.Placement="Left"
                                           VerticalAlignment="Center" ToolTipOpening="NameToolTipOpening"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:Name="CpuColumn" Header="CPU" SortMemberPath="cpu" Width="63"
                                    ElementStyle="{StaticResource NumericCell}" Binding="{Binding CpuText}"/>
                <DataGridTextColumn x:Name="MemoryColumn" Header="内存" SortMemberPath="mem" Width="83"
                                    ElementStyle="{StaticResource NumericCell}" Binding="{Binding MemoryText}"/>
                <DataGridTextColumn Header="下载" SortMemberPath="down" Width="88"
                                    ElementStyle="{StaticResource NumericCell}" Binding="{Binding DownloadText}"/>
                <DataGridTextColumn Header="上传" SortMemberPath="up" Width="88"
                                    ElementStyle="{StaticResource NumericCell}" Binding="{Binding UploadText}"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="EmptyText" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource ProcessHeaderText}" IsHitTestVisible="False"/>
        <DockPanel Grid.Row="3" Margin="0,8,0,0" MinHeight="28">
            <Button x:Name="TrafficAction" DockPanel.Dock="Right" Margin="8,0,0,0"
                    Padding="8,4" Click="TrafficActionClick">
                <StackPanel Orientation="Horizontal">
                    <local:PanelIcon Data="{StaticResource IconShield}" Width="13" Height="13" Margin="0,0,5,0"/>
                    <TextBlock x:Name="TrafficActionText" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity="0.8"
                       TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis"
                       ToolTipService.Placement="Left"/>
        </DockPanel>
    </Grid>
</Window>
