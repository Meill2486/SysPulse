<Window x:Class="SysPulse.OverviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SysPulse"
        Title="SysPulse 概览" Width="346" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True"
        FontSize="12" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <LinearGradientBrush x:Key="OverviewDarkCard" StartPoint="0,0" EndPoint="0.85,1">
            <GradientStop Color="#F42B405F" Offset="0"/>
            <GradientStop Color="#F91B293F" Offset="0.52"/>
            <GradientStop Color="#FC152033" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="OverviewLightCard" StartPoint="0,0" EndPoint="0.85,1">
            <GradientStop Color="#FAFFFFFF" Offset="0"/>
            <GradientStop Color="#F5ECF4FE" Offset="0.54"/>
            <GradientStop Color="#F9DCE9FA" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="OverviewAction" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="23"/>
            <Setter Property="Foreground" Value="{DynamicResource OverviewSecondary}"/>
            <Setter Property="Background" Value="{DynamicResource OverviewSurface}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource OverviewHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MetricIcon" TargetType="local:PanelIcon" BasedOn="{StaticResource {x:Type local:PanelIcon}}">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Foreground" Value="{DynamicResource OverviewSecondary}"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
        <Style x:Key="SecondaryText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource OverviewSecondary}"/>
        </Style>
        <Style x:Key="NumericText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="2.5" Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Indicator" CornerRadius="2.5" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="Card" CornerRadius="12" BorderThickness="1" Padding="11,8,11,9">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Style="{StaticResource OverviewAction}"
                        ToolTip="设置" AutomationProperties.Name="设置" Click="OpenSettings">
                    <local:PanelIcon Data="{StaticResource IconSettings}" Width="14" Height="14"/>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource OverviewAction}" Margin="0,0,4,0"
                        ToolTip="进程明细" AutomationProperties.Name="进程明细" Click="OpenProcesses">
                    <local:PanelIcon Data="{StaticResource IconList}" Width="14" Height="14"/>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <local:PanelIcon x:Name="TitleIcon" Data="{StaticResource IconActivity}" Width="15" Height="15"
                                     Foreground="{DynamicResource OverviewAccent}" Margin="0,0,6,0"/>
                    <TextBlock x:Name="PanelTitle" Text="系统概览" FontSize="15" FontWeight="SemiBold"/>
                </StackPanel>
            </DockPanel>
            <Border x:Name="HeaderDivider" Grid.Row="1" Height="1" Margin="0,2,0,6"
                    Background="{Binding BorderBrush, ElementName=Card}"/>
            <ScrollViewer x:Name="BodyScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="系统概览指标">
                <StackPanel>
            <!-- 固定蓝雾布局：指标、进度条、规格分行，容量与规格放不下时整体换行。 -->
            <Grid x:Name="UsageGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="51"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="111"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="23"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <local:PanelIcon Data="{StaticResource IconCpu}" Style="{StaticResource MetricIcon}"/>
                    <TextBlock Text="CPU"/>
                </StackPanel>
                <ProgressBar x:Name="CpuBar" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" AutomationProperties.Name="CPU 使用率"/>
                <TextBlock x:Name="CpuPercent" Grid.Column="3" TextAlignment="Right" Style="{StaticResource NumericText}"/>
                <!-- CPU 规格异步补齐前也占一行，避免首开后再把下方内容推移。 -->
                <TextBlock x:Name="CpuSpec" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" FontSize="11" MinHeight="16"
                           Visibility="Hidden"
                           Style="{StaticResource SecondaryText}" ToolTipService.Placement="Left"
                           ToolTipOpening="ShowTruncatedValue"/>
                <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <local:PanelIcon Data="{StaticResource IconMemory}" Style="{StaticResource MetricIcon}"/>
                    <TextBlock Text="内存"/>
                </StackPanel>
                <ProgressBar x:Name="MemoryBar" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" AutomationProperties.Name="内存使用率"/>
                <TextBlock x:Name="MemoryPercent" Grid.Row="3" Grid.Column="3" TextAlignment="Right" Style="{StaticResource NumericText}"/>
                <WrapPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,2" SizeChanged="DetailSizeChanged">
                    <TextBlock x:Name="MemoryInfo" FontSize="11" Margin="0,0,10,0" Style="{StaticResource SecondaryText}"
                               ToolTipService.Placement="Left" ToolTipOpening="ShowTruncatedValue"/>
                    <TextBlock x:Name="MemorySpec" FontSize="11" MinHeight="16" Visibility="Collapsed"
                               Style="{StaticResource SecondaryText}" ToolTipService.Placement="Left"
                               ToolTipOpening="ShowTruncatedValue"/>
                </WrapPanel>
                <StackPanel Grid.Row="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <local:PanelIcon Data="{StaticResource IconDisk}" Style="{StaticResource MetricIcon}"/>
                    <TextBlock Text="容量"/>
                </StackPanel>
                <ProgressBar x:Name="DiskBar" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" AutomationProperties.Name="系统卷容量占用率"/>
                <TextBlock x:Name="DiskPercent" Grid.Row="6" Grid.Column="3" TextAlignment="Right" Style="{StaticResource NumericText}"/>
                <WrapPanel Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,2" SizeChanged="DetailSizeChanged">
                    <TextBlock x:Name="DiskInfo" FontSize="11" Margin="0,0,10,0" Style="{StaticResource SecondaryText}"
                               ToolTipService.Placement="Left" ToolTipOpening="ShowTruncatedValue"/>
                    <TextBlock x:Name="DiskSpec" FontSize="11" MinHeight="16" Visibility="Collapsed"
                               Style="{StaticResource SecondaryText}" ToolTipService.Placement="Left"
                               ToolTipOpening="ShowTruncatedValue"/>
                </WrapPanel>
            </Grid>
            <Border x:Name="NetworkBox" Background="{DynamicResource OverviewSurface}" CornerRadius="7" Margin="0,10,0,0" Padding="10"
                    SizeChanged="DetailSizeChanged">
                <StackPanel>
                    <!-- 保留实时值、累计值和方向图标的固定列；说明归入卡片页脚。 -->
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="86"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="17"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="22"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Column="1" Text="实时网速" FontSize="11" TextAlignment="Right"
                                   Style="{StaticResource SecondaryText}"/>
                        <Border Grid.Column="2" Grid.RowSpan="3" Width="1" Margin="0,3,13,3"
                                HorizontalAlignment="Right" Background="{Binding BorderBrush, ElementName=Card}"/>
                        <TextBlock Grid.Column="3" Text="本段累计" FontSize="11" Style="{StaticResource SecondaryText}"/>
                        <TextBlock Grid.Row="1" Text="下载" Margin="17,0,0,0" Style="{StaticResource SecondaryText}"/>
                        <TextBlock Grid.Row="2" Text="上传" Margin="17,0,0,0" Style="{StaticResource SecondaryText}"/>
                        <local:PanelIcon x:Name="DownloadArrow" Grid.Row="1" Grid.Column="2"
                                         Data="{StaticResource IconDownload}" Width="12" Height="12"
                                         HorizontalAlignment="Left" Margin="4,0,0,0"/>
                        <local:PanelIcon x:Name="UploadArrow" Grid.Row="2" Grid.Column="2"
                                         Data="{StaticResource IconUpload}" Width="12" Height="12"
                                         HorizontalAlignment="Left" Margin="4,0,0,0"/>
                        <TextBlock x:Name="Download" Grid.Row="1" Grid.Column="1" TextAlignment="Right"
                                   Style="{StaticResource NumericText}"/>
                        <TextBlock x:Name="Upload" Grid.Row="2" Grid.Column="1" TextAlignment="Right"
                                   Style="{StaticResource NumericText}"/>
                        <TextBlock x:Name="Received" Grid.Row="1" Grid.Column="3"/>
                        <TextBlock x:Name="Sent" Grid.Row="2" Grid.Column="3"/>
                    </Grid>
                    <Border Height="1" Margin="0,8,0,6" Background="{Binding BorderBrush, ElementName=Card}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="NetworkSource" Text="全部活动实体网卡" FontSize="11"
                                   Style="{StaticResource SecondaryText}"/>
                        <TextBlock Grid.Column="1" Text="· 非计费用量" FontSize="11" Margin="6,0,4,0"
                                   Style="{StaticResource SecondaryText}"/>
                        <Button x:Name="NetworkHelp" Grid.Column="2" Style="{StaticResource OverviewAction}" Width="24" Height="24"
                                AutomationProperties.Name="网络统计口径" ToolTipService.InitialShowDelay="150"
                                ToolTipService.ShowsToolTipOnKeyboardFocus="True">
                            <Button.ToolTip>
                                <ToolTip MaxWidth="280">
                                    <TextBlock x:Name="NetworkExplanation" TextWrapping="Wrap" TextTrimming="None"
                                               Text="接口吞吐包含局域网，不等于互联网计费用量；进程流量单独统计，不与网卡强行配平。切换接口后从新统计段累计。"/>
                                </ToolTip>
                            </Button.ToolTip>
                            <local:PanelIcon Data="{StaticResource IconInfo}" Width="13" Height="13"/>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="NetworkStatus" FontSize="11" LineHeight="16" Margin="0,6,0,0"
                               Visibility="Collapsed" TextWrapping="Wrap" TextTrimming="None"/>
                </StackPanel>
            </Border>
            <Border x:Name="HardwareBox" Background="{DynamicResource OverviewSurface}" CornerRadius="7" Margin="0,10,0,0" Padding="10"
                    SizeChanged="DetailSizeChanged">
                <StackPanel>
                    <Grid MinHeight="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="74"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <local:PanelIcon Data="{StaticResource IconDisk}" Style="{StaticResource MetricIcon}"/>
                            <TextBlock x:Name="DiskIoLabel" FontSize="11" Style="{StaticResource SecondaryText}"/>
                        </StackPanel>
                        <StackPanel x:Name="DiskReadout" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="读" FontSize="11" Margin="0,0,4,0" Style="{StaticResource SecondaryText}"/>
                            <TextBlock x:Name="DiskRead" FontSize="11" Style="{StaticResource NumericText}"/>
                        </StackPanel>
                        <StackPanel x:Name="DiskWriteout" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="写" FontSize="11" Margin="0,0,4,0" Style="{StaticResource SecondaryText}"/>
                            <TextBlock x:Name="DiskWrite" FontSize="11" Style="{StaticResource NumericText}"/>
                        </StackPanel>
                        <TextBlock x:Name="DiskPending" Grid.Column="1" Grid.ColumnSpan="2" FontSize="11"
                                   HorizontalAlignment="Right" Visibility="Collapsed" Style="{StaticResource SecondaryText}"/>
                    </Grid>
                    <TextBlock x:Name="DiskStatus" FontSize="11" LineHeight="16" Margin="0,6,0,0" Visibility="Collapsed"
                               TextWrapping="Wrap" TextTrimming="None"/>
                    <Border Height="1" Margin="0,6,0,6" Background="{Binding BorderBrush, ElementName=Card}"/>
                    <StackPanel x:Name="GpuDetails"/>
                    <TextBlock x:Name="GpuStatus" FontSize="11" LineHeight="16" Margin="0,6,0,0" Visibility="Collapsed"
                               TextWrapping="Wrap" TextTrimming="None"/>
                </StackPanel>
            </Border>
            <Border Height="1" Margin="0,10,0,6" Background="{Binding BorderBrush, ElementName=Card}"/>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="最近 60 秒" FontSize="11" Style="{StaticResource SecondaryText}"/>
                <TextBlock Grid.Column="1" Text="缺样断线" FontSize="11" Style="{StaticResource SecondaryText}"/>
            </Grid>
            <UniformGrid Columns="2">
                <StackPanel Margin="0,0,5,0"><TextBlock Text="CPU" FontSize="10" Style="{StaticResource SecondaryText}"/><local:MiniChart x:Name="CpuTrend" Height="25" IsHitTestVisible="False"/></StackPanel>
                <StackPanel Margin="5,0,0,0"><TextBlock Text="内存" FontSize="10" Style="{StaticResource SecondaryText}"/><local:MiniChart x:Name="MemoryTrend" Height="25" IsHitTestVisible="False"/></StackPanel>
                <StackPanel Margin="0,3,5,0"><TextBlock Text="下载 · 自适应量程" FontSize="10" Style="{StaticResource SecondaryText}"/><local:MiniChart x:Name="DownloadTrend" Height="25" IsHitTestVisible="False"/></StackPanel>
                <StackPanel Margin="5,3,0,0"><TextBlock Text="上传 · 自适应量程" FontSize="10" Style="{StaticResource SecondaryText}"/><local:MiniChart x:Name="UploadTrend" Height="25" IsHitTestVisible="False"/></StackPanel>
            </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
